{
  "name": "lms-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @lms/api",
    "dev:web": "npm run dev --workspace @lms/web",
    "build": "npm run build --workspace @lms/contracts && npm run build --workspace @lms/api && npm run build --workspace @lms/web && npm run build --workspace @lms/worker",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:indexes": "npm run db:indexes --workspace @lms/api",
    "worker": "npm run start --workspace @lms/worker"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.15.32",
    "concurrently": "9.2.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.72.0"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "mongoose": "^9.11.3"
  }
}
