{
  "name": "@lms/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/tests/*.test.ts",
    "db:indexes": "tsx src/scripts/create-indexes.ts"
  },
  "dependencies": {
    "@lms/contracts": "0.1.0",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "mongoose": "8.24.6",
    "pino": "9.7.0",
    "pino-http": "10.4.0",
    "redis": "5.5.6",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3"
  }
}
